# Contoso Travel Concierge — environment variables template.
#
# 01-provision.sh writes a real .env by reading `azd env get-values` and
# filling in the placeholders below. Anything left blank in the real .env
# comes from a resource that has not been provisioned yet (for example, the
# container-registry values only appear after 02-hosted-agent.sh runs).
#
# Do NOT commit the resulting .env — it contains subscription IDs.

# ---- Provisioning identity ----
AZD_ENV_NAME=
AZURE_ENV_NAME=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus2
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# ---- Foundry project ----
AZURE_AI_ACCOUNT_ID=
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_ID=
AZURE_AI_PROJECT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=

# ---- Model deployments ----
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_AI_JUDGE_DEPLOYMENT_NAME=gpt-5.4-judge

# ---- Observability ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_RESOURCE_ID=

# ---- Hosted-agent extras (populated by 02-hosted-agent.sh) ----
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_AI_PROJECT_ACR_CONNECTION_NAME=
ENABLE_HOSTED_AGENTS=false
